# ============================================================
# Пример файла настроек. Скопируйте его в .env и заполните.
#   Windows:  copy .env.example .env
#   Linux/Mac: cp .env.example .env
# Файл .env НЕ попадает в git (см. .gitignore).
# ============================================================

# ---------- Подключение к Яндекс.Почте (IMAP, только чтение) ----------
YANDEX_IMAP_HOST=imap.yandex.ru
YANDEX_IMAP_PORT=993
YANDEX_EMAIL=
# Пароль приложения Яндекса (НЕ основной пароль от аккаунта!)
# Создаётся в https://id.yandex.ru -> Безопасность -> Пароли приложений -> Почта
YANDEX_APP_PASSWORD=

# ---------- OpenAI ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Необязательно: адрес совместимого API (прокси). Пустое значение = api.openai.com
OPENAI_BASE_URL=

# ---------- База данных ----------
DATABASE_URL=sqlite:///./data/mail_assistant.db

# ---------- Режимы работы ----------
# DEMO_MODE=true — работа на тестовых письмах без подключения к реальной почте
DEMO_MODE=false
# AI_ENABLED=false — анализ выполняется только правилами, без обращения к OpenAI (бесплатно)
AI_ENABLED=true
# AI_TEST_MODE=true — вместо реального вызова OpenAI используется офлайн-анализатор
AI_TEST_MODE=false
# Максимум цепочек, анализируемых через AI за один запуск (контроль расходов)
AI_MAX_THREADS_PER_RUN=50

# ---------- Режим только для чтения ----------
# ВАЖНО: в первой версии программа не изменяет почту. Значение true менять нельзя.
READ_ONLY_MODE=true

# ---------- Вложения ----------
SAVE_ATTACHMENTS=false
ATTACHMENTS_DIR=./data/attachments
# Максимальный размер сохраняемого вложения, МБ
MAX_ATTACHMENT_SIZE_MB=25

# ---------- Веб-сервер ----------
APP_HOST=127.0.0.1
APP_PORT=8000
OPEN_BROWSER=true

# ---------- Логи ----------
LOG_LEVEL=INFO
LOG_DIR=./logs

# ---------- Корпоративные адреса (можно изменить позже в интерфейсе) ----------
# Домены компании через запятую, например: mycompany.ru,mycompany.com
CORPORATE_DOMAINS=
# Дополнительные корпоративные адреса через запятую (если домен общий, напр. yandex.ru)
CORPORATE_EMAILS=

# ---------- Рабочее время (можно изменить позже в интерфейсе) ----------
TIMEZONE=Europe/Moscow
