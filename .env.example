# Скопируйте этот файл в .env.local и заполните реальными значениями.
# Без этих переменных сайт продолжит работать: формы будут проходить валидацию,
# но заявки только логируются на сервере (см. src/lib/notify.ts), без реальной отправки.

# --- Email (отправка заявок на почту через SMTP) ---
LEADS_EMAIL=info@example.com
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=leads@example.com
SMTP_PASSWORD=

# --- Telegram (отправка заявок в Telegram-бот) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Аналитика (необязательно, публичные идентификаторы) ---
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_GA_ID=
