# Реальные учётные данные администратора не хранятся в репозитории.
# Шаблон: config.example.php — скопируйте его в config.php на хостинге.
/config.php

# Пользовательские обращения и вложения (создаются на сервере).
/_private/submissions/

# Локальная разработка
/node_modules/
/.dev-runtime/
/dist/
/screenshots/

# Готовые файлы документов хранятся в репозитории — это публичные
# документы партнёрства. Исключены только временные файлы.
/documents/files/*.tmp
npm-debug.log*
