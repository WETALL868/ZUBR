# ==========================================================================
#  Настройки Apache.
#
#  Чистые URL работают без mod_rewrite: адреса — это физические каталоги
#  с index.php. Правила ниже добавляют только удобства и защиту.
#  Инструкция для Nginx — в README_DEPLOY.md.
# ==========================================================================

# ── Кодировка и индексные файлы ───────────────────────────────────────────
AddDefaultCharset UTF-8
DirectoryIndex index.php index.html

# Запрет листинга каталогов
Options -Indexes

# ── Страницы ошибок ───────────────────────────────────────────────────────
ErrorDocument 404 /404.php

# ── Защита служебных каталогов ────────────────────────────────────────────
# Конфигурация, исходники, логи и очередь писем не должны открываться извне.
RedirectMatch 404 ^/(config|src|storage|tests|tools|includes|templates|content)(/|$)

<FilesMatch "\.(md|log|json|lock|sql|ini|yml|yaml|sample)$">
    Require all denied
</FilesMatch>

<Files "composer.json">
    Require all denied
</Files>

# Запрет выполнения PHP в каталогах, куда что-либо загружается
<IfModule mod_rewrite.c>
    RewriteEngine On

    # sitemap.xml → sitemap.php (если статический файл не сгенерирован)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^sitemap\.xml$ /sitemap.php [L]

    # Часть карты: /sitemap-geo.xml → /sitemap.php?part=geo
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^sitemap-([a-z]+)\.xml$ /sitemap.php?part=$1 [L,QSA]

    # ── HTTPS ────────────────────────────────────────────────────────────
    # Включите, когда установлен сертификат:
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # ── Канонический хост ────────────────────────────────────────────────
    # Выберите ОДИН вариант и раскомментируйте.
    # Без www:
    # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    # RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
    # С www:
    # RewriteCond %{HTTP_HOST} !^www\. [NC]
    # RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]

    # Слэш в конце адреса для каталогов (единообразие URL)
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_URI} !/$
    RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# ── Кэширование статики ───────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType image/avif "access plus 6 months"
    ExpiresByType image/svg+xml "access plus 6 months"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Ассеты подключаются с меткой ?v=время изменения файла,
    # поэтому их можно кэшировать надолго.
    <FilesMatch "\.(css|js|woff2|webp|avif|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Заголовки безопасности дублируются в PHP; здесь — для статики.
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Сжатие ────────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
