{
  "name": "novaya-iskan-site",
  "version": "1.1.0",
  "private": true,
  "description": "Сайт СНП «Новая Искань» — статические страницы + PHP-бэкенд. Node нужен только для разработки и проверок, на хостинге он не требуется.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "php -S 127.0.0.1:8080 -t . tools/dev-router.php",
    "lint": "npm run lint:js && npm run lint:php && npm run lint:html",
    "lint:js": "eslint assets tools tests",
    "lint:php": "node tools/lint-php.mjs",
    "lint:html": "node tools/lint-html.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "build": "node tools/build.mjs",
    "audit:responsive": "node tools/audit.mjs",
    "screenshots": "node tools/screenshots.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "images": "node tools/optimize-images.mjs",
    "photo:oka": "node tools/install-oka-photo.mjs",
    "documents": "node tools/build-documents.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "globals": "^15.15.0",
    "linkedom": "^0.18.6",
    "playwright": "1.56.1",
    "sharp": "^0.35.3",
    "typescript": "^5.7.2"
  }
}
