Options -Indexes

# ---------------------------------------------------------------------------
# Routing
# ---------------------------------------------------------------------------

# Страницы собираются из базы, поэтому index.php должен идти первым: иначе
# оставшийся на сервере старый index.html перекрыл бы новую страницу.
DirectoryIndex index.php index.html

RewriteEngine On

# Служебные каталоги закрыты наглухо: в config лежит пароль базы, в storage —
# сама база и загруженные файлы, в cms — код панели управления. В каждом из
# них есть свой .htaccess, но правило продублировано здесь: часть хостингов
# читает только корневой файл, и полагаться на вложенные нельзя.
RewriteRule ^(config|storage|cms)(/|$) - [F,L]
RewriteRule ^_backup - [F,L]

# YML feed for Yandex.Market on a clean URL.
RewriteRule ^yandexmarket\.xml$ yandexmarket/index.php [L,QSA]

# Карта сайта строится из базы. Правило стоит до проверки файлов: если на
# сервере остался старый sitemap.xml, поисковики всё равно получат свежий.
RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]

# Order form endpoint without the .php suffix (the front-end tries /api/order
# first; without this rule every submit wasted a round-trip on a 404).
RewriteRule ^api/order/?$ api/order.php [L,QSA]

# Карточки товаров. Отдельных папок products/<slug>/ больше нет — адрес
# обслуживает один контроллер, который берёт товар из базы по slug.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^products/([^/]+)/?$ products/index.php?slug=$1 [L,QSA]

# Категории. Правило последнее и срабатывает, только если такого файла и
# такой папки на диске нет: новая категория, созданная в CMS, получает
# адрес /<slug>/ без единой строки кода и без новой папки на сервере.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9][a-z0-9_-]*)/?$ route.php?slug=$1 [L,QSA]

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS application/ld+json application/xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Caching
#
# Static assets are versioned in markup (styles.css?v=2) or have stable
# content-addressed names, so they can be cached hard. HTML must stay
# revalidated, otherwise a redeploy is invisible to returning visitors.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType image/x-icon           "access plus 1 year"
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType text/html              "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # -------------------------------------------------------------------------
  # Security headers
  # -------------------------------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

  # Enable once the domain is confirmed HTTPS-only (max-age is hard to undo).
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Never leak the PHP version.
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>

# Директив php_flag / php_admin_flag здесь намеренно нет: expose_php задаётся
# только в php.ini, а в .htaccess такая строка на части хостингов приводит к
# ошибке 500 на всём сайте. Заголовок с версией PHP уже снят выше
# правилом «Header always unset X-Powered-By».

# ---------------------------------------------------------------------------
# MIME types / charset
# ---------------------------------------------------------------------------
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

# ---------------------------------------------------------------------------
# Block access to sensitive files
# ---------------------------------------------------------------------------
<FilesMatch "^(mail-config|config)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "\.(jsonl|log|bak|sql|ini|sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
