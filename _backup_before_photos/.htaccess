# Резервные копии файлов сайта в том виде, в каком они были ДО перевода цен
# на единый файл /data/prices.json. Папка закрыта от посетителей и поисковых
# систем: это архив, а не часть сайта. Удалять её не нужно — она пригодится,
# если понадобится сравнить старую и новую версию страницы.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Deny from all
</IfModule>
